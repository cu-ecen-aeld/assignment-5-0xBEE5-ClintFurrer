#! /bin/sh

MODULE_DIR="/lib/modules/$(uname -r)/extra"

case "$1" in
start)
echo "Starting init script for Module Loading"
    cd "$MODULE_DIR" || exit 1
    /bin/scull_load || exit 1
    /bin/module_load faulty || exit 1
    /bin/module_load hello || exit 1
;;
stop)
echo "Removing user modules"
    cd "$MODULE_DIR" || exit 1
    /bin/module_unload hello
    /bin/module_unload faulty
    /bin/scull_unload
;;
*)
echo "Usage: $0 {start|stop}"
exit 1
esac
exit 0

